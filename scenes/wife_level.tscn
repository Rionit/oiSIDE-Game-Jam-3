[sub_resource type="Resource" id="Resource_houl4"]
script = ExtResource("2_lyar0")
speaker = 2
text = "Babe, I've got some   [tornado radius=10.0 freq=1.0 connected=1][i]exciting[/i][/tornado]   news!"
metadata/_custom_type_script = "uid://dq2ptpf5yrene"

[sub_resource type="Resource" id="Resource_lyar0"]
script = ExtResource("2_lyar0")
text = "What is it?"
metadata/_custom_type_script = "uid://dq2ptpf5yrene"

[sub_resource type="Resource" id="Resource_um04b"]
script = ExtResource("2_lyar0")
speaker = 2
text = "I finally got a [shake]job[/shake]!"
metadata/_custom_type_script = "uid://dq2ptpf5yrene"

[sub_resource type="Resource" id="Resource_ks0wj"]
script = ExtResource("2_lyar0")
speaker = 2
text = "And with an actually [shake]decent[/shake] salary!"
metadata/_custom_type_script = "uid://dq2ptpf5yrene"

[sub_resource type="Resource" id="Resource_75o4k"]
script = ExtResource("2_lyar0")
text = "That's [shake]amazing[/shake]! What's the title?"
metadata/_custom_type_script = "uid://dq2ptpf5yrene"

[sub_resource type="Resource" id="Resource_r3va0"]
script = ExtResource("2_lyar0")
speaker = 2
text = "I'm not gonna tell you ;)"
metadata/_custom_type_script = "uid://dq2ptpf5yrene"

[sub_resource type="Resource" id="Resource_gi7cj"]
script = ExtResource("2_lyar0")
text = "Alright, keep your secrets then."
metadata/_custom_type_script = "uid://dq2ptpf5yrene"

[sub_resource type="Resource" id="Resource_jle2q"]
script = ExtResource("2_lyar0")
text = "Speaking of work."
metadata/_custom_type_script = "uid://dq2ptpf5yrene"

[sub_resource type="Resource" id="Resource_cl6cl"]
script = ExtResource("2_lyar0")
text = "I might have found a gig that's going to make us a ton of money."
metadata/_custom_type_script = "uid://dq2ptpf5yrene"

[sub_resource type="Resource" id="Resource_akiuo"]
script = ExtResource("2_lyar0")
speaker = 2
text = "[shake]Let me guess...[/shake]"
metadata/_custom_type_script = "uid://dq2ptpf5yrene"

[sub_resource type="Resource" id="Resource_aeql5"]
script = ExtResource("2_lyar0")
text = "Yup"
metadata/_custom_type_script = "uid://dq2ptpf5yrene"

[sub_resource type="Resource" id="Resource_4eo05"]
script = ExtResource("2_lyar0")
text = "[shake]Can't tell you.[/shake]"
metadata/_custom_type_script = "uid://dq2ptpf5yrene"

